# =============================================================================
# RK Travel Hub - Environment Configuration Template
# Copy this file to .env.local and fill in your actual production/staging values.
# NEVER commit .env.local, API keys, or secret tokens to Git repository.
# =============================================================================

# 1. Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 2. Administrator Portal Authentication (Server-Side Only)
# Strong admin email / username (default: admin@gmail.com)
ADMIN_USER=admin@gmail.com
# Strong complex administrator password (minimum 12 characters recommended)
ADMIN_PASS=your_strong_admin_password_here
# Secret key used to sign HMAC-SHA256 admin session tokens
ADMIN_SESSION_SECRET=your_32_character_random_hex_or_base64_session_secret

# 3. Automated Backup & Cron Security (Server-Side Only)
# Secret bearer token used by Vercel Cron or Google Cloud Scheduler to trigger backups
CRON_SECRET=your_strong_random_cron_secret_token

# 4. Twilio Cloud WhatsApp Notifications (Server-Side Only)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Sandbox sender: +14155238886 (or approved WhatsApp Business Sender)
TWILIO_WHATSAPP_FROM=+14155238886
# Administrator WhatsApp recipient phone (e.g. +919876543210)
TWILIO_ADMIN_PHONE=+919876543210
# Optional Twilio Content Template SID (HX...) if pre-approved WhatsApp templates are used
TWILIO_CONTENT_SID=
# Optional Webhook Status Callback URL (e.g. https://travel-rk.vercel.app/api/webhooks/twilio)
TWILIO_STATUS_CALLBACK_URL=https://travel-rk.vercel.app/api/webhooks/twilio

# 5. Deployment Environment
NEXT_PUBLIC_APP_URL=https://travel-rk.vercel.app
