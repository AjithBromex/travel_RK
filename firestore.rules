rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'admin@gmail.com' ||
          request.auth.token.email.matches('(?i)^admin@.*')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')) ||
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'Admin'))
      );
    }

    // 1. Users collection:
    // - Public READ is allowed only for username resolution during login
    // - WRITES are strictly restricted to authenticated users modifying their own profile or admins
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == staffId || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. Business Collections (Trips, Vehicles, Payments, Expenses, Cashbook, Reminders)
    // - Accessible to all authenticated staff members
    match /trips/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /vehicles/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /payments/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /expenses/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /cashbook/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /reminders/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /settings/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Trash & Recovery System
    // - Authenticated staff and admins can move documents to trash and restore them
    // - Permanent purge is restricted to authorized administrators
    match /trash/{id} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 4. Backup & Disaster Recovery System (30-day retention)
    // - Authenticated users can read and create backup snapshots
    // - Only authorized administrators can update or delete backups
    match /backups/{id} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 5. System & Audit Logs (Immutable activity trail)
    match /audit_logs/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 6. Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
