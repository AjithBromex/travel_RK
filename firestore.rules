rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email == 'admin@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower() == 'admin') ||
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
         'role' in get(/databases/$(database)/documents/staff/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role.lower() == 'admin')
      );
    }

    // 1. Users collection:
    // - Authenticated staff and admins can read user profiles
    // - Self-signup allowed, but non-admins cannot set or escalate role to 'admin'
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role.lower() != 'admin'))
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
      );
      allow delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == staffId && (!('role' in request.resource.data) || request.resource.data.role.lower() != 'admin'))
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == staffId && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
      );
      allow delete: if isAdmin();
    }

    // 2. Business Collections (Trips, Vehicles, Payments, Expenses, Cashbook, Reminders)
    // - Accessible to all authenticated staff members
    match /trips/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /vehicles/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /payments/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /expenses/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /cashbook/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /reminders/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /settings/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Trash & Recovery System
    // - Authenticated staff and admins can move documents to trash and restore them
    // - Permanent purge is restricted to authorized administrators
    match /trash/{id} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 4. Backup & Disaster Recovery System (Includes chunked backups subcollection)
    // - Authenticated users can read and create backup snapshots
    // - Only authorized administrators can update or delete backups
    match /backups/{id} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin();

      match /chunks/{chunkId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }

    // 5. System & Audit Logs (Immutable activity trail)
    match /audit_logs/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 6. Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
