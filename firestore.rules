rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Users collection:
    // - Public READ is allowed only for username resolution during login
    // - WRITES are strictly restricted to authenticated users modifying their own profile or admins
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 2. Business Collections (Trips, Vehicles, Payments, Expenses, Cashbook, Reminders)
    // - Accessible to all authenticated staff members
    match /trips/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /vehicles/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /payments/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /expenses/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /cashbook/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /reminders/{id} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // 3. System & Audit Logs (Immutable: cannot be edited or deleted by anyone)
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 4. Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
